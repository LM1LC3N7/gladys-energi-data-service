{
  "name": "gladys-energi-data-service",
  "version": "0.1.1",
  "private": true,
  "description": "Danish electricity prices for Gladys Assistant from Energi Data Service (Energinet open data): the hourly tariff of every grid company, Energinet's tariffs, the elafgift and the DK1/DK2 spot price, VAT included, as a delegated energy contract.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-timeout=60000",
    "audit": "npm audit --omit=dev",
    "cover": "node scripts/cover.mjs cover.png",
    "snapshot": "node scripts/snapshot.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LM1LC3N7/gladys-energi-data-service.git"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0"
}
